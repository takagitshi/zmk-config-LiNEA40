#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
};

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        mouse_lt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&mkp>;

            display-name = "Mouse Layer-Tap";
        };

        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_none: sensor_rotate_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exit_app {
            bindings = <&kp LG(Q)>;
            key-positions = <8 9>;
        };

        log_off {
            bindings = <&kp LG(LC(Q))>;
            key-positions = <39 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&kp Q         &kp W         &kp E             &kp R  &kp T                                         &kp Y          &kp U  &lt 3 I    &kp O       &kp P
&kp A         &kp S         &kp D             &kp F  &kp G                                         &kp H          &kp J  &lt 2 K    &kt L       &kp MINUS
&mt LSHIFT Z  &kp X         &kp C             &kp V  &kp B                                         &kp N          &kp M  &lt 4 COMMA  &kp DOT     &mt RSHIFT QUESTION
&kp TAB       &kp LEFT_ALT  &kp LEFT_COMMAND  &none  &lt 5 LANGUAGE_1  &lt 6 SPACE    &lt 7 ENTER  &kp BACKSPACE         &kp LCTRL  &kp DELETE  &kp TILDE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&trans      &trans        &trans            &trans  &trans                    &trans  &trans    &trans           &trans    &trans
&trans      &trans        &trans            &trans  &trans                    &trans  &mkp MB1  &mouse_lt 2 MB3  &mkp MB2  &kp RIGHT_COMMAND
&kp LSHIFT  &trans        &trans            &trans  &trans                    &trans  &trans    &trans           &trans    &trans
&trans      &kp LEFT_ALT  &kp LEFT_COMMAND  &trans  &trans  &trans    &trans  &trans            &trans           &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_3 {
            display-name = "Gesture 1";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans              &kp LC(UP_ARROW)    &trans               &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &kp LC(LEFT_ARROW)  &trans              &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans              &kp LC(DOWN_ARROW)  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans              &trans               &trans
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_4 {
            display-name = "Gesture 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &kp LG(T)     &trans        &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &kp LC(LS(TAB))  &trans        &kp LC(TAB)  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &kp LG(LS(N))  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                &trans        &trans        &trans
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_5 {
            display-name = "symbol";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR     &kp PERCENT                     &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LG(LS(N3))   &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LA(A)      &kp LG(LA(S))                   &kp MINUS  &kp EQUAL      &kp SLASH      &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans          &kp LG(LA(C))   &kp LG(LA(V))  &trans                          &trans     &trans         &kp SEMICOLON  &kp SQT               &kp GRAVE
&kp ESCAPE       &trans          &trans          &trans         &trans         &mo 8    &trans  &trans                    &trans         &trans                &trans
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_6 {
            display-name = "number";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp MINUS
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH
&kp F11  &kp F12  &trans  &trans  &trans                         &kp N1        &kp N2        &kp N3        &kp COMMA     &kp EQUAL
&trans   &trans   &trans  &trans  &trans   &trans    &kp PERIOD  &kp NUMBER_0                &trans        &kp COLON     &kp LA(Y)
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_7 {
            display-name = "move";
            bindings = <
&trans  &kp LG(N0)              &kp LG(MINUS)      &kp LG(PLUS)             &trans                            &kp LG(T)      &kp LC(LS(TAB))     &kp UP_ARROW    &kp LC(TAB)          &kp LG(W)
&trans  &kp K_MUTE              &kp C_VOLUME_DOWN  &kp C_VOLUME_UP          &trans                            &kp LC(A)      &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp LC(E)
&trans  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(F))      &kp LA(LC(RIGHT_ARROW))  &trans                            &kp HOME       &kp LG(LEFT_ARROW)  &kp LG(LA(P))   &kp LG(RIGHT_ARROW)  &kp END
&trans  &trans                  &trans             &trans                   &kp LANGUAGE_2  &trans    &trans  &kp LG(LS(N))                      &trans          &kp LG(R)            &kp LG(LS(H))
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_8 {
            display-name = "setting";
            bindings = <
&out OUT_BLE  &out OUT_USB  &none  &none  &none                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none         &none         &none  &none  &none                                 &none         &none         &none         &none         &none
&none         &none         &none  &none  &bootloader                           &bootloader   &none         &none         &none         &none
&none         &none         &none  &none  &none        &none    &studio_unlock  &none                       &none         &bt BT_CLR    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_9 {
            display-name = "Precision";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&encoder_none>;
        };

    };
};
